#include <ESP8266WiFi.h>
#include <WiFiClientSecure.h>
#include <PubSubClient.h>
#include <WiFiManager.h>
#include <SoftwareSerial.h>
#include <ArduinoJson.h>

#define LORA_RX   D2
#define LORA_TX   D1
#define LORA_M0   D7
#define LORA_M1   D6

SoftwareSerial LoRaSerial(LORA_RX, LORA_TX);

const char* mqtt_server = "b7fea2bf.ala.asia-southeast1.emqxsl.com";
const uint16_t mqtt_port = 8883;
const char* mqtt_user = "eps8266nn";
const char* mqtt_pass = "yu155414";

WiFiClientSecure secureClient;
PubSubClient mqttClient(secureClient);

String gatewayId;

void setLoRaMode() {
  digitalWrite(LORA_M0, LOW);
  digitalWrite(LORA_M1, LOW);
  delay(100);
}

void setup() {
  Serial.begin(115200);
  LoRaSerial.begin(9600);          // ← 已改为 9600（最常用）

  pinMode(LORA_M0, OUTPUT);
  pinMode(LORA_M1, OUTPUT);
  setLoRaMode();

  gatewayId = "door_gateway_" + String(ESP.getChipId(), HEX);

  Serial.println("LoRa 接收网关启动 → " + gatewayId);

  WiFiManager wm;
  wm.autoConnect("LORA_GATEWAY");

  secureClient.setInsecure();
  mqttClient.setServer(mqtt_server, mqtt_port);
  mqttClient.setBufferSize(256);

  Serial.println("系统就绪，等待 LoRa 数据...");
}

void loop() {
  if (WiFi.status() == WL_CONNECTED) {
    if (!mqttClient.connected()) {
      mqttClient.connect(gatewayId.c_str(), mqtt_user, mqtt_pass);
    }
    mqttClient.loop();
  }

  // 接收 LoRa 数据并转发
  if (LoRaSerial.available()) {
    String data = LoRaSerial.readStringUntil('\n');
    data.trim();
    if (data.length() > 20) {
      Serial.println("收到 LoRa: " + data);
      forwardToMQTT(data);
    }
  }

  // 每15秒主动请求一次数据
  static unsigned long lastAsk = 0;
  if (millis() - lastAsk > 15000) {
    LoRaSerial.println("STATUS");
    lastAsk = millis();
  }

  delay(10);
}

// ====================== 转发到 MQTT ======================
void forwardToMQTT(String jsonStr) {
  if (mqttClient.connected()) {
    // 使用发送端的真实 Device ID，让网页直接可用
    String topic = "door/door_772ef9/status";     // ←←← 请改成你发送端的实际ID
    
    mqttClient.publish(topic.c_str(), jsonStr.c_str(), true);
    Serial.println("已转发到 MQTT → 网页可显示");
  }
}
